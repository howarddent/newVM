      Left = 20
      Height = 15
      Top = 204
      Width = 81
      Caption = 'FFT Epoch Size:'
    end
    object EpochCombo: TComboBox
      Left = 170
      Height = 23
      Top = 200
      Width = 90
      ItemHeight = 15
      ItemIndex = 4
      Items.Strings = (
        '512'
        '1024'
        '2048'
        '4096'
        '8192'
        '16384'
      )
      Style = csDropDownList
      TabOrder = 14
