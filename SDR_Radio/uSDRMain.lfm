object Form1: TForm1
  Left = 200
  Height = 922
  Top = 80
  Width = 1300
  Caption = 'newVM SDR Spectrum Analyser'
  ClientHeight = 922
  ClientWidth = 1300
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  object ControlPanel: TPanel
    Left = 0
    Height = 335
    Top = 0
    Width = 1300
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 335
    ClientWidth = 1300
    TabOrder = 0
    object FreqLabel: TLabel
      Left = 20
      Height = 15
      Top = 18
      Width = 100
      Caption = 'Center Freq (MHz):'
    end
    object FreqEdit: TFloatSpinEdit
      Left = 156
      Height = 23
      Top = 14
      Width = 100
      DecimalPlaces = 3
      Increment = 0.1
      MaxValue = 6000
      MinValue = 1
      TabOrder = 0
      Value = 95
      OnEditingDone = FreqEditEditingDone
    end
    object KeypadButton: TButton
      Left = 264
      Height = 25
      Top = 13
      Width = 90
      Caption = 'Keypad...'
      TabOrder = 1
      OnClick = KeypadButtonClick
    end
    object RateLabel: TLabel
      Left = 372
      Height = 15
      Top = 18
      Width = 107
      Caption = 'Sample Rate (Msps):'
    end
    object RateCombo: TComboBox
      Left = 506
      Height = 23
      Top = 14
      Width = 80
      ItemHeight = 15
      Style = csDropDownList
      TabOrder = 2
    end
    object ConnectButton: TButton
      Left = 606
      Height = 28
      Top = 12
      Width = 100
      Caption = 'Connect'
      TabOrder = 3
      OnClick = ConnectButtonClick
    end
    object StartStopButton: TButton
      Left = 718
      Height = 28
      Top = 12
      Width = 100
      Caption = 'Start'
      Enabled = False
      TabOrder = 4
      OnClick = StartStopButtonClick
    end
    object StatusLabel: TLabel
      Left = 20
      Height = 15
      Top = 288
      Width = 79
      Caption = 'Not connected'
    end
    object GainStage0Label: TLabel
      Left = 20
      Height = 15
      Top = 118
      Width = 65
      Caption = 'Gain Stage 0'
      Visible = False
    end
    object GainStage0TrackBar: TTrackBar
      Left = 20
      Height = 30
      Top = 136
      Width = 260
      Max = 1
      Position = 0
      OnChange = GainStage0TrackBarChange
      TabOrder = 5
      Visible = False
    end
    object GainStage1Label: TLabel
      Left = 300
      Height = 15
      Top = 118
      Width = 65
      Caption = 'Gain Stage 1'
      Visible = False
    end
    object GainStage1TrackBar: TTrackBar
      Left = 300
      Height = 30
      Top = 136
      Width = 260
      Max = 1
      Position = 0
      OnChange = GainStage1TrackBarChange
      TabOrder = 6
      Visible = False
    end
    object GainStage2CheckBox: TCheckBox
      Left = 580
      Height = 19
      Top = 120
      Width = 83
      Caption = 'Gain Stage 2'
      TabOrder = 7
      Visible = False
      OnChange = GainStage2CheckBoxChange
    end
    object BiasTCheckBox: TCheckBox
      Left = 580
      Height = 19
      Top = 148
      Width = 143
      Caption = 'Bias-T (Antenna Power)'
      TabOrder = 8
      Visible = False
      OnChange = BiasTCheckBoxChange
    end
    object ShowAxesCheckBox: TCheckBox
      Left = 20
      Height = 19
      Top = 78
      Width = 74
      Caption = 'Show Axes'
      Checked = True
      State = cbChecked
      TabOrder = 9
      OnChange = ShowAxesCheckBoxChange
    end
    object PeakDetectCheckBox: TCheckBox
      Left = 140
      Height = 19
      Top = 78
      Width = 80
      Caption = 'Peak Detect'
      TabOrder = 10
      OnChange = PeakDetectCheckBoxChange
    end
    object PeakThresholdLabel: TLabel
      Left = 270
      Height = 15
      Top = 64
      Width = 109
      Caption = 'Peak Threshold: 60%'
    end
    object PeakThresholdTrackBar: TTrackBar
      Left = 270
      Height = 30
      Top = 80
      Width = 170
      Frequency = 10
      Max = 100
      Position = 60
