object Form1: TForm1
  Left = 260
  Height = 760
  Top = 120
  Width = 1100
  Caption = 'newVM HackRF Spectrum Analyser'
  ClientHeight = 760
  ClientWidth = 1100
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  Position = poScreenCenter
  LCLVersion = '4.99.0.0'
  object ControlPanel: TPanel
    Left = 0
    Height = 118
    Top = 0
    Width = 1100
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 118
    ClientWidth = 1100
    TabOrder = 0
    object FreqLabel: TLabel
      Left = 12
      Height = 15
      Top = 11
      Width = 140
      Caption = 'Center Freq (MHz):'
    end
    object FreqEdit: TFloatSpinEdit
      Left = 160
      Height = 23
      Top = 7
      Width = 90
      DecimalPlaces = 3
      Increment = 0.1
      MaxValue = 6000
      MinValue = 1
      TabOrder = 0
      Value = 95
      OnEditingDone = FreqEditEditingDone
    end
    object RateLabel: TLabel
      Left = 270
      Height = 15
      Top = 11
      Width = 130
      Caption = 'Sample Rate (Msps):'
    end
    object RateCombo: TComboBox
      Left = 410
      Height = 23
      Top = 7
      Width = 70
      ItemHeight = 15
      ItemIndex = 5
      Items.Strings = (
        '2'
        '4'
        '8'
        '10'
        '16'
        '20'
      )
      Style = csDropDownList
      TabOrder = 1
      Text = '20'
    end
    object AmpCheckBox: TCheckBox
      Left = 500
      Height = 19
      Top = 9
      Width = 140
      Caption = 'RF Amp (+14dB)'
      TabOrder = 2
      OnChange = AmpCheckBoxChange
    end
    object ConnectButton: TButton
      Left = 660
      Height = 25
      Top = 6
      Width = 90
      Caption = 'Connect'
      TabOrder = 3
      OnClick = ConnectButtonClick
    end
    object StartStopButton: TButton
      Left = 756
      Height = 25
      Top = 6
      Width = 90
      Caption = 'Start'
      Enabled = False
      TabOrder = 4
      OnClick = StartStopButtonClick
    end
    object StatusLabel: TLabel
      Left = 860
      Height = 15
      Top = 11
      Width = 220
      Anchors = [akTop, akRight]
      Caption = 'Not connected'
    end
    object LNAGainLabel: TLabel
      Left = 12
      Height = 15
      Top = 42
      Width = 110
      Caption = 'LNA Gain: 16 dB'
    end
    object LNATrackBar: TTrackBar
      Left = 12
      Height = 30
      Top = 58
      Width = 220
      Frequency = 8
      Max = 40
      Min = 0
      Position = 16
      TabOrder = 5
      OnChange = LNATrackBarChange
    end
    object VGAGainLabel: TLabel
      Left = 250
      Height = 15
      Top = 42
      Width = 110
      Caption = 'VGA Gain: 20 dB'
    end
    object VGATrackBar: TTrackBar
      Left = 250
      Height = 30
      Top = 58
      Width = 220
      Frequency = 2
      Max = 62
      Min = 0
      Position = 20
      TabOrder = 6
      OnChange = VGATrackBarChange
    end
    object ShowAxesCheckBox: TCheckBox
      Left = 500
      Height = 19
      Top = 50
      Width = 90
      Checked = True
      Caption = 'Show Axes'
      State = cbChecked
      TabOrder = 7
      OnChange = ShowAxesCheckBoxChange
    end
    object ResetViewButton: TButton
      Left = 600
      Height = 25
      Top = 47
      Width = 90
      Caption = 'Reset View'
      TabOrder = 8
      OnClick = ResetViewButtonClick
    end
    object HintLabel: TLabel
      Left = 12
      Height = 15
      Top = 96
      Width = 640
      Caption = '8192-sample epochs, Hamming windowed and FFT''d live. Drag to rotate, wheel to zoom.'
    end
  end
end
