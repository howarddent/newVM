      Position = 0
      OnChange = YOffsetTrackBarChange
      TabOrder = 15
    end
    object YGainLabel: TLabel
      Left = 568
      Height = 15
      Top = 184
      Width = 60
      Caption = 'Y Gain: 1.0x'
    end
    object YGainTrackBar: TTrackBar
      Left = 560
      Height = 30
      Top = 208
      Width = 220
      Frequency = 5
      Max = 50
      Min = 1
      Position = 10
      OnChange = YGainTrackBarChange
      TabOrder = 16
    end
    object HintLabel: TLabel
      Left = 20
      Height = 15
      Top = 260
      Width = 565
      Caption = 'Each epoch is Hamming windowed and FFT''d live. Drag the spectrum, or use Left/Right, to move its cursor.'
    end
