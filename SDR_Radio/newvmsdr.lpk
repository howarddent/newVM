<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="4">
    <Name Value="newVMSDR"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="Howard Dent"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="..;..\Graphs"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)/$(LCLWidgetType)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <IncludeAssertionCode Value="True"/>
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Description Value="Design-time/run-time LCL components for newVM's SDR_Radio project: TSDRRFSource, a non-visual component wrapping USB SDR front-end detection (HackRF/RTL-SDR/SDRplay) and exposing a single-precision complex IQ epoch stream, and TSDRSpectrumAnalyser, a spectrum+waterfall display component that consumes that stream and runs its windowing/FFT on the GPU via newVMCL/OpenCL when available."/>
    <License Value="Same terms as the parent newVM project."/>
    <Version Release="1"/>
    <Files Count="6">
      <Item1>
        <Filename Value="uSDRRFSource.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSDRRFSource"/>
      </Item1>
      <Item2>
        <Filename Value="uVMPlotSDRSpectrum.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uVMPlotSDRSpectrum"/>
      </Item2>
      <Item3>
        <Filename Value="uDSPBlocks.pas"/>
        <UnitName Value="uDSPBlocks"/>
      </Item3>
      <Item4>
        <Filename Value="uWaveOutPlayer.pas"/>
        <UnitName Value="uWaveOutPlayer"/>
      </Item4>
      <Item5>
        <Filename Value="uFMReceiver.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uFMReceiver"/>
      </Item5>
      <Item6>
        <Filename Value="uAMReceiver.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uAMReceiver"/>
      </Item6>
    </Files>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="LazOpenGLContext"/>
      </Item1>
      <Item2>
        <PackageName Value="LCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
