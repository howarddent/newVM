object Form1: TForm1
  Left = 280
  Height = 700
  Top = 150
  Width = 1000
  Caption = 'newVM OpenGL Waterfall Stack Demo'
  ClientHeight = 700
  ClientWidth = 1000
  OnCreate = FormCreate
  Position = poScreenCenter
  LCLVersion = '4.99.0.0'
  object ControlPanel: TPanel
    Left = 0
    Height = 40
    Top = 0
    Width = 1000
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 40
    ClientWidth = 1000
    TabOrder = 0
    object AddGraphButton: TButton
      Left = 12
      Height = 25
      Top = 7
      Width = 100
      Caption = 'Add Graph'
      TabOrder = 0
      OnClick = AddGraphButtonClick
    end
    object AnimateCheckBox: TCheckBox
      Left = 130
      Height = 19
      Top = 10
      Width = 90
      Caption = 'Animate'
      TabOrder = 1
      OnChange = AnimateCheckBoxChange
    end
    object ShowAxesCheckBox: TCheckBox
      Left = 230
      Height = 19
      Top = 10
      Width = 90
      Checked = True
      Caption = 'Show Axes'
      State = cbChecked
      TabOrder = 2
      OnChange = ShowAxesCheckBoxChange
    end
    object ResetViewButton: TButton
      Left = 330
      Height = 25
      Top = 7
      Width = 90
      Caption = 'Reset View'
      TabOrder = 3
      OnClick = ResetViewButtonClick
    end
    object HintLabel: TLabel
      Left = 440
      Height = 15
      Top = 12
      Width = 300
      Caption = 'Drag to rotate, wheel to zoom'
    end
  end
end
