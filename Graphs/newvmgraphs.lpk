<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="4">
    <Name Value="newVMGraphs"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="Howard Dent"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value=".."/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)/$(LCLWidgetType)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <IncludeAssertionCode Value="True"/>
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Description Value="Design-time/run-time LCL components for the newVM matrix/vector library: TVMPlot2D, an OpenGL line-plot control that renders one or more TVMobj vectors, TVMPlot3D, an OpenGL height-field control that renders a real TVMobj matrix as a lit 3D surface, and TVMPlotStack, an OpenGL waterfall control that stacks successive TVMobj vectors receding into the distance over time."/>
    <License Value="Same terms as the parent newVM project."/>
    <Version Release="3"/>
    <Files Count="3">
      <Item1>
        <Filename Value="uVMPlot2D.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uVMPlot2D"/>
      </Item1>
      <Item2>
        <Filename Value="uVMPlot3D.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uVMPlot3D"/>
      </Item2>
      <Item3>
        <Filename Value="uVMPlotStack.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uVMPlotStack"/>
      </Item3>
    </Files>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="LazOpenGLContext"/>
      </Item1>
      <Item2>
        <PackageName Value="LCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
