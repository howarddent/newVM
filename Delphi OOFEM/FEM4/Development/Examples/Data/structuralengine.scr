
Include "structuralengine.pos";

// View[0] is the vector 'Displacement' view PostProcess writes first;
// VectorType = 5 is gmsh's "displacement" mode, which moves the mesh by
// that vector rather than drawing arrows at each node.

View[0].VectorType = 5;

// Hide the six scalar views the .pos also carries (Ux, Uy, Sxx, Syy,
// Sxy, VonMises). They are drawn on the UNdeformed mesh, so with all
// seven visible at once they sit on top of the deformed shape and hide
// it completely - the animation runs correctly but nothing appears to
// move. They stay listed under Post-processing and can be re-ticked
// individually at any time; this only clears them from the initial view.

For i In {1:PostProcessing.NbViews-1}
  View[i].Visible = 0;
EndFor

// Scale the animation to the actual solution rather than to a fixed
// factor. The previous hard-coded peak of 0.25 made the animation
// invisible even on its own: displacements here run to ~3.4e-05 on a
// beam 6 long, so the peak on-screen offset came to 8.5e-06 - roughly
// 1.4e-06 of the model, orders of magnitude below one pixel.
//
// Deriving the factor from View[0].Max (the largest displacement
// magnitude, which gmsh computes as the view loads) makes the peak a
// fixed fraction of the model's own length whatever the solution
// magnitude - which matters because it varies a lot here: load case 3
// pushes ten times harder than load case 1, and the material stiffness
// and mesh are free to change too. For load case 1 this works out at a
// factor of ~8800.

PeakFraction = 0.05;
ModelLength = View[0].MaxX - View[0].MinX;
UMax = View[0].Max;

If (UMax > 0)
  PeakFactor = PeakFraction * ModelLength / UMax;
Else
  // Rigid or all-zero solution - nothing to animate, and dividing by
  // UMax would be a division by zero.
  PeakFactor = 0;
EndIf

NSteps = 50;

For i In {1:NSteps}
  View[0].DisplacementFactor = PeakFactor * i / NSteps;
  Draw;
EndFor

For i In {NSteps:1:-1}
  View[0].DisplacementFactor = PeakFactor * i / NSteps;
  Draw;
EndFor

// Settle at the peak so the window is left showing the deformed shape.
// The old script ramped back to 0 and stopped there, so the final frame
// was the undeformed mesh - the deformation was only ever on screen
// mid-animation.

View[0].DisplacementFactor = PeakFactor;
Draw;
