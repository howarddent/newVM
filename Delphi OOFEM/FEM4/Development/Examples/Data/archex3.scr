// Generated by ArchEx3 - do not edit, it is rewritten on every run.

Include "archex3.pos";

// Show only the displacement vector view while it animates.
For i In {0:PostProcessing.NbViews-1}
  View[i].Visible = 0;
EndFor

View[0].Visible = 1;
View[0].VectorType = 5;   // gmsh displacement mode

// Scale the animation to the solution: an arch of this stiffness
// settles by a few hundredths of a millimetre, far below one pixel
// at any fixed factor.
PeakFraction = 0.05;
ModelLength = View[0].MaxX - View[0].MinX;
UMax = View[0].Max;

If (UMax > 0)
  PeakFactor = PeakFraction * ModelLength / UMax;
Else
  PeakFactor = 0;
EndIf

NSteps = 40;

For i In {1:NSteps}
  View[0].DisplacementFactor = PeakFactor * i / NSteps;
  Draw;
EndFor

For i In {NSteps:1:-1}
  View[0].DisplacementFactor = PeakFactor * i / NSteps;
  Draw;
EndFor

// Settle on the masonry diagram: the hoop stress - the arch thrust
// itself, negative (compressive) everywhere the arch is working
// properly - with the thrust line drawn over it between the two
// middle-third boundaries it has to stay inside.
View[0].Visible = 0;
View[3].Visible = 1;

View[11].Visible = 1;
View[11].LineWidth = 4;
View[11].ShowScale = 0;
View[11].ColormapNumber = 9;   // grayscale, so it reads
                              // against the stress colours

View[12].Visible = 1;
View[12].LineWidth = 1;
View[12].ShowScale = 0;

Draw;

// The other views (Ux, Uy, S1, S2, Sxx, Syy, Sxy, VonMises,
// Block) are all loaded - tick them in the Post-processing tree.
