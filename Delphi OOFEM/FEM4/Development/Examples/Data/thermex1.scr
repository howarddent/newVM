// Generated by ThermEx1 - do not edit, it is rewritten every
// time the View button is pressed.
//
// 25 frames, 5 minutes apart, of case 2 at 5.0 L/min.

Merge "thermex1_000.pos";
Merge "thermex1_001.pos";
Merge "thermex1_002.pos";
Merge "thermex1_003.pos";
Merge "thermex1_004.pos";
Merge "thermex1_005.pos";
Merge "thermex1_006.pos";
Merge "thermex1_007.pos";
Merge "thermex1_008.pos";
Merge "thermex1_009.pos";
Merge "thermex1_010.pos";
Merge "thermex1_011.pos";
Merge "thermex1_012.pos";
Merge "thermex1_013.pos";
Merge "thermex1_014.pos";
Merge "thermex1_015.pos";
Merge "thermex1_016.pos";
Merge "thermex1_017.pos";
Merge "thermex1_018.pos";
Merge "thermex1_019.pos";
Merge "thermex1_020.pos";
Merge "thermex1_021.pos";
Merge "thermex1_022.pos";
Merge "thermex1_023.pos";
Merge "thermex1_024.pos";

// One scale for every frame. Without this each view normalises to
// its own range and the cooling becomes invisible.
For i In {0:PostProcessing.NbViews-1}
  View[i].RangeType = 2;   // custom
  View[i].CustomMin = 29.7362899272;
  View[i].CustomMax = 37.2700134087;
  View[i].Visible = 0;
  View[i].Clip = 1;        // clipping plane 0, below
EndFor

View[0].Visible = 1;

// Slice every segment lengthways, keeping what lies below the plane
// - the half resting on the cushion - so looking down on it shows
// the cut face: every compartment of every segment and the gradient
// through them, rather than an opaque skin. The plane is at the
// height of the arms' axes, the lowest segment centre, which cuts
// the head, trunk and legs well inside their cores.
//
// ClipWholeElements matters. Left at 0 the clip is a plain OpenGL
// one, which cuts through the drawn surfaces and leaves the solid
// hollow - a shell seen from inside. At 1 whole elements are
// dropped instead, so the faces the cut exposes are real element
// faces and carry the field, at the price of a stepped edge one
// element deep. Note also that a second plane would not narrow
// this to a slab: gmsh keeps an element that satisfies ANY
// enabled plane, so two planes here draw the whole body again.
// Move it, or add more, under Tools > Clipping.
General.ClipWholeElements = 1;
General.Clip0A = 0;
General.Clip0B = -1;
General.Clip0C = 0;
General.Clip0D = 0.0377224015;

// Look straight down on the patient, head at the top of the window
// and the patient's left on the right, as if standing over them.
// Checked by rendering: -90 about x alone looks UP from under the
// table at the backs, and 90 about x alone puts the head at the
// bottom. gmsh fits the view to the model's cross-section rather
// than to a two-metre body seen end on, so it is scaled down to fit.
General.Trackball = 0;
General.RotationX = 90;
General.RotationY = 180;
General.RotationZ = 0;
General.ScaleX = 0.35;
General.ScaleY = 0.35;
General.ScaleZ = 0.35;

// Animate by stepping through the views, not through time steps
// inside one view: each frame is its own view here, with a single
// step in it. Press play in the status bar to run it, or the
// buttons either side of play to step frame by frame; the up and
// down arrow keys move from view to view as well. (The LEFT and
// RIGHT arrows step time steps within a view, so they do nothing
// here.)
PostProcessing.AnimationCycle = 1;
PostProcessing.AnimationDelay = 0.2;
