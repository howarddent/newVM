# Free Pascal / Lazarus build artifacts
lib/
*.o
*.ppu
*.rsj
*.compiled
*.res
newVMtest
newVMtest.exe

# Third-party runtime DLLs that are sometimes copied next to the exe for
# local testing (see CLAUDE.md's Windows build notes) - not project sources
openblas.dll

# Demo project binaries: each demos/<Name>/ produces an extensionless
# binary named after its project - ignore those, keep everything with
# an extension (.pas/.lpr/.lpi/.lfm/.ico/...).
demos/*/[A-Za-z]*
!demos/*/*.*

# Same for Graphs/<Name>/ (Plot2D, Plot3D) - unlike demos/, these are only
# ignored on Linux where the binary has no extension; Windows .exe builds
# are caught by the unscoped *.exe rule below either way.
Graphs/*/[A-Za-z]*
!Graphs/*/*.*

# Windows demo binaries do have an extension (.exe), so the negations above
# re-include them - this rule comes after those negations (later patterns
# win) to actually exclude them, e.g. demos/SpectralDiff/SpectralDiff.exe.
*.exe

# Lazarus IDE session state (per-user, not shared project config)
*.lps

# Claude Code local settings
.claude/settings.local.json
