      TabOrder = 0
      OnClick = btnSaveClick
    end
    object btnRefresh: TButton
      Left = 1310
      Height = 25
      Top = 6
      Width = 100
      Anchors = [akTop, akRight]
      Caption = 'Fetch again'
      TabOrder = 1
      OnClick = btnRefreshClick
    end
  end
  object dlgSave: TSaveDialog
    DefaultExt = '.png'
    Filter = 'PNG image|*.png'
    Options = [ofOverwritePrompt, ofEnableSizing, ofViewDetail]
    Left = 40
    Top = 40
  end
