object fmBio: TfmBio
  Left = 250
  Height = 800
  Top = 100
  Width = 1200
  Caption = 'newVM biological signal spectra demo - ECG, EEG and arterial pressure from PhysioNet'
  ClientHeight = 800
  ClientWidth = 1200
  Position = poScreenCenter
  LCLVersion = '4.99.0.0'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  object pnlTop: TPanel
    Left = 0
    Height = 40
    Top = 0
    Width = 1200
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 40
    ClientWidth = 1200
    TabOrder = 0
    object lblFmax: TLabel
      Left = 8
      Height = 15
      Top = 12
      Width = 250
      Caption = 'Plot spectrum up to (Hz, 0 = Nyquist frequency):'
    end
    object seFmax: TFloatSpinEdit
      Left = 290
      Height = 23
      Top = 8
      Width = 90
      DecimalPlaces = 1
      Increment = 5
      MaxValue = 1000
      MinValue = 0
      TabOrder = 0
      Value = 0
      OnChange = seFmaxChange
    end
    object cbLinear: TCheckBox
      Left = 410
      Height = 19
      Top = 10
      Width = 200
      Caption = 'Linear scale (units^2/Hz instead of dB)'
      TabOrder = 1
      OnChange = cbLinearChange
    end
  end
  object pcSignals: TPageControl
    Left = 0
    Height = 760
    Top = 40
    Width = 1200
    ActivePage = tsECG
    Align = alClient
    TabIndex = 0
    TabOrder = 1
    object tsECG: TTabSheet
      Caption = 'ECG'
      ClientHeight = 732
      ClientWidth = 1192
      object memECG: TMemo
        Left = 862
        Height = 732
        Top = 0
        Width = 330
        Align = alRight
        Font.Name = 'Consolas'
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
        WordWrap = False
      end
      object pnlECG: TPanel
        Left = 0
        Height = 732
        Top = 0
        Width = 862
        Align = alClient
        BevelOuter = bvNone
        TabOrder = 1
      end
    end
    object tsEEG: TTabSheet
      Caption = 'EEG'
      ClientHeight = 732
      ClientWidth = 1192
      object memEEG: TMemo
        Left = 862
        Height = 732
        Top = 0
        Width = 330
        Align = alRight
        Font.Name = 'Consolas'
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
        WordWrap = False
      end
      object pnlEEG: TPanel
        Left = 0
        Height = 732
        Top = 0
        Width = 862
        Align = alClient
        BevelOuter = bvNone
        TabOrder = 1
      end
    end
    object tsABP: TTabSheet
      Caption = 'Arterial pressure'
      ClientHeight = 732
      ClientWidth = 1192
      object memABP: TMemo
        Left = 862
        Height = 732
        Top = 0
        Width = 330
        Align = alRight
        Font.Name = 'Consolas'
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
        WordWrap = False
      end
      object pnlABP: TPanel
        Left = 0
        Height = 732
        Top = 0
        Width = 862
        Align = alClient
        BevelOuter = bvNone
        TabOrder = 1
      end
    end
    object tsSynth: TTabSheet
      Caption = 'Square and triangle waves'
      ClientHeight = 732
      ClientWidth = 1192
      object pnlSynthCtl: TPanel
        Left = 0
        Height = 40
        Top = 0
        Width = 1192
        Align = alTop
        BevelOuter = bvNone
        ClientHeight = 40
        ClientWidth = 1192
        TabOrder = 0
        object lblF0: TLabel
          Left = 8
          Height = 15
          Top = 10
          Width = 160
          Caption = 'Fundamental frequency f0 (Hz):'
        end
        object seF0: TFloatSpinEdit
          Left = 190
          Height = 23
          Top = 6
          Width = 90
          DecimalPlaces = 2
          Increment = 1
          MaxValue = 200
          MinValue = 0.25
          TabOrder = 0
          Value = 5
          OnChange = seF0Change
        end
        object rgWave: TRadioGroup
          Left = 320
          Height = 34
          Top = 1
          Width = 300
          AutoFill = True
          Caption = 'Show'
          Columns = 3
          ItemIndex = 2
          Items.Strings = (
            'Square'
            'Triangle'
            'Both'
          )
          TabOrder = 1
          OnSelectionChanged = rgWaveSelectionChanged
        end
      end
      object memSynth: TMemo
        Left = 812
        Height = 696
        Top = 36
        Width = 380
        Align = alRight
        Font.Name = 'Consolas'
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 1
        WordWrap = False
      end
      object pnlSynth: TPanel
        Left = 0
        Height = 696
        Top = 36
        Width = 812
        Align = alClient
        BevelOuter = bvNone
        TabOrder = 2
        OnResize = SynthPanelResize
      end
    end
    object tsSynthesis: TTabSheet
      Caption = 'Square wave synthesis'
      ClientHeight = 732
      ClientWidth = 1192
      object pnlSynCtl: TPanel
        Left = 0
        Height = 40
        Top = 0
        Width = 1192
        Align = alTop
        BevelOuter = bvNone
        ClientHeight = 40
        ClientWidth = 1192
        TabOrder = 0
        object lblSynF0: TLabel
          Left = 8
          Height = 15
          Top = 12
          Width = 160
          Caption = 'Fundamental frequency f0 (Hz):'
        end
        object seSynF0: TFloatSpinEdit
          Left = 190
          Height = 23
          Top = 8
          Width = 90
          DecimalPlaces = 2
          Increment = 1
          MaxValue = 50
          MinValue = 0.25
          TabOrder = 0
          Value = 5
          OnChange = SynthesisChange
        end
        object lblTerms: TLabel
          Left = 310
          Height = 15
          Top = 12
          Width = 170
          Caption = 'Odd harmonics added (1 .. 10):'
        end
        object seTerms: TSpinEdit
          Left = 490
          Height = 23
          Top = 8
          Width = 60
          MaxValue = 10
          MinValue = 1
          TabOrder = 1
          Value = 10
          OnChange = SynthesisChange
        end
        object cbAllSums: TCheckBox
          Left = 580
          Height = 19
          Top = 10
          Width = 200
          Caption = 'Overlay every partial sum'
          Checked = True
          State = cbChecked
          TabOrder = 2
          OnChange = SynthesisChange
        end
      end
      object memSyn: TMemo
        Left = 812
        Height = 692
        Top = 40
        Width = 380
        Align = alRight
        Font.Name = 'Consolas'
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 1
        WordWrap = False
      end
      object pnlSyn: TPanel
        Left = 0
        Height = 692
        Top = 40
        Width = 812
        Align = alClient
        BevelOuter = bvNone
        TabOrder = 2
        OnResize = SynPanelResize
      end
    end
    object tsBispectrum: TTabSheet
      Caption = 'EEG bispectrum'
      ClientHeight = 732
      ClientWidth = 1192
      object pnlBiCtl: TPanel
        Left = 0
        Height = 84
        Top = 0
        Width = 1192
        Align = alTop
        BevelOuter = bvNone
        ClientHeight = 84
        ClientWidth = 1192
        TabOrder = 0
        object rgBiSignal: TRadioGroup
          Left = 8
          Height = 38
          Top = 44
          Width = 300
          AutoFill = True
          Caption = 'Signal'
          Columns = 2
          ItemIndex = 0
          Items.Strings = (
            'EEG (300 s)'
            'Two tones through x + k x^2'
          )
          TabOrder = 4
          OnSelectionChanged = BispectrumChange
        end
        object pnlBiSynth: TPanel
          Left = 320
          Height = 38
          Top = 44
          Width = 600
          BevelOuter = bvNone
          ClientHeight = 38
          ClientWidth = 600
          TabOrder = 5
          Visible = False
          object lblFa: TLabel
            Left = 0
            Height = 15
            Top = 12
            Width = 50
            Caption = 'fa (Hz):'
          end
          object seFa: TFloatSpinEdit
            Left = 50
            Height = 23
            Top = 8
            Width = 70
            DecimalPlaces = 1
            Increment = 1
            MaxValue = 30
            MinValue = 0.5
            TabOrder = 0
            Value = 6
            OnChange = BispectrumChange
          end
          object lblFb: TLabel
            Left = 140
            Height = 15
            Top = 12
            Width = 50
            Caption = 'fb (Hz):'
          end
          object seFb: TFloatSpinEdit
            Left = 190
            Height = 23
            Top = 8
            Width = 70
            DecimalPlaces = 1
            Increment = 1
            MaxValue = 30
            MinValue = 0.5
            TabOrder = 1
            Value = 10
            OnChange = BispectrumChange
          end
          object lblK: TLabel
            Left = 280
            Height = 15
            Top = 12
            Width = 120
            Caption = 'nonlinearity k:'
          end
          object seK: TFloatSpinEdit
            Left = 380
            Height = 23
            Top = 8
            Width = 70
            DecimalPlaces = 2
            Increment = 0.1
            MaxValue = 5
            MinValue = 0
            TabOrder = 2
            Value = 0.5
            OnChange = BispectrumChange
          end
        end
        object lblBiFmax: TLabel
          Left = 8
          Height = 15
          Top = 14
          Width = 130
          Caption = 'f1, f2 up to (Hz):'
        end
        object seBiFmax: TFloatSpinEdit
          Left = 130
          Height = 23
          Top = 10
          Width = 70
          DecimalPlaces = 0
          Increment = 5
          MaxValue = 62
          MinValue = 5
          TabOrder = 0
          Value = 30
          OnChange = BispectrumChange
        end
        object lblEpoch: TLabel
          Left = 220
          Height = 15
          Top = 14
          Width = 110
          Caption = 'Epoch length (s):'
        end
        object seEpoch: TFloatSpinEdit
          Left = 330
          Height = 23
          Top = 10
          Width = 70
          DecimalPlaces = 1
          Increment = 0.5
          MaxValue = 10
          MinValue = 0.5
          TabOrder = 1
          Value = 2
          OnChange = BispectrumChange
        end
        object rgBiKind: TRadioGroup
          Left = 420
          Height = 38
          Top = 2
          Width = 330
          AutoFill = True
          Caption = 'Show'
          Columns = 2
          ItemIndex = 1
          Items.Strings = (
            'Bispectrum magnitude |B|'
            'Bicoherence (0 .. 1)'
          )
          TabOrder = 2
          OnSelectionChanged = BispectrumChange
        end
        object cbLevelCurves: TCheckBox
          Left = 770
          Height = 19
          Top = 12
          Width = 120
          Caption = 'Level curves'
          TabOrder = 3
          OnChange = cbLevelCurvesChange
        end
      end
      object memBi: TMemo
        Left = 812
        Height = 648
        Top = 84
        Width = 380
        Align = alRight
        Font.Name = 'Consolas'
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 1
        WordWrap = False
      end
      object pnlBi: TPanel
        Left = 0
        Height = 648
        Top = 84
        Width = 812
        Align = alClient
        BevelOuter = bvNone
        TabOrder = 2
      end
    end
  end
end
