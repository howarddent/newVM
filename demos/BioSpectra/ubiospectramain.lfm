object fmBio: TfmBio
  Left = 250
  Height = 800
  Top = 100
  Width = 1200
  Caption = 'newVM biological signal spectra demo - ECG, EEG, arterial pressure (PhysioNet) and EEG under anaesthesia (VitalDB)'
  ClientHeight = 800
  ClientWidth = 1200
  Position = poScreenCenter
  LCLVersion = '4.99.0.0'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  object pnlTop: TPanel
    Left = 0
    Height = 40
    Top = 0
    Width = 1200
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 40
    ClientWidth = 1200
    TabOrder = 0
    object lblFmax: TLabel
      Left = 8
      Height = 15
      Top = 12
      Width = 400
      Caption = 'Plot spectrum up to (Hz; 0 = 40 ECG/EEG, 20 pressure):'
    end
    object seFmax: TFloatSpinEdit
      Left = 420
      Height = 23
      Top = 8
      Width = 90
      DecimalPlaces = 1
      Increment = 5
      MaxValue = 1000
      MinValue = 0
      TabOrder = 0
      Value = 0
      OnChange = seFmaxChange
    end
    object cbLinear: TCheckBox
      Left = 540
      Height = 19
      Top = 10
      Width = 260
      Caption = 'Linear scale (units^2/Hz instead of dB)'
      Checked = True
      State = cbChecked
      TabOrder = 1
      OnChange = cbLinearChange
    end
  end
