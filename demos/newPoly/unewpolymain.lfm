object Form1: TForm1
  Left = 300
  Height = 760
  Top = 150
  Width = 1000
  Caption = 'newVM polynomial fitting demo'
  ClientHeight = 760
  ClientWidth = 1000
  Position = poScreenCenter
  LCLVersion = '4.99.0.0'
  OnCreate = FormCreate
  object pnlControls: TPanel
    Left = 0
    Height = 120
    Top = 0
    Width = 1000
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 120
    ClientWidth = 1000
    TabOrder = 0
    object rgDegree: TRadioGroup
      Left = 8
      Height = 104
      Top = 8
      Width = 160
      AutoFill = True
      Caption = 'Polynomial degree'
      ClientHeight = 84
      ClientWidth = 156
      ItemIndex = 1
      Items.Strings = (
        '1  (linear)'
        '2  (quadratic)'
        '3  (cubic)'
      )
      TabOrder = 0
      OnSelectionChanged = rgDegreeSelectionChanged
    end
    object lblSigma: TLabel
      Left = 184
      Height = 15
      Top = 16
      Width = 112
      Caption = 'Noise sigma (N(0, s)):'
    end
    object seSigma: TFloatSpinEdit
      Left = 184
      Height = 23
      Top = 36
      Width = 90
      Increment = 0.25
      MaxValue = 20
      MinValue = 0
      TabOrder = 1
      Value = 1
      OnChange = seSigmaChange
    end
    object btnNewData: TButton
      Left = 184
      Height = 25
      Top = 76
      Width = 90
      Caption = 'New data'
      TabOrder = 2
      OnClick = btnNewDataClick
    end
    object memResults: TMemo
      Left = 296
      Height = 104
      Top = 8
      Width = 696
      Anchors = [akTop, akLeft, akRight]
      Font.Name = 'Consolas'
      ParentFont = False
      ReadOnly = True
      ScrollBars = ssAutoVertical
      TabOrder = 3
    end
  end
  object pnlPlots: TPanel
    Left = 0
    Height = 640
    Top = 120
    Width = 1000
    Align = alClient
    BevelOuter = bvNone
    TabOrder = 1
    OnResize = pnlPlotsResize
  end
end
