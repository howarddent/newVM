object Form1: TForm1
  Left = 300
  Height = 800
  Top = 120
  Width = 1000
  Caption = 'newVM resonance and damping demo'
  ClientHeight = 800
  ClientWidth = 1000
  Position = poScreenCenter
  LCLVersion = '4.99.0.0'
  OnCreate = FormCreate
  object pnlControls: TPanel
    Left = 0
    Height = 130
    Top = 0
    Width = 1000
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 130
    ClientWidth = 1000
    TabOrder = 0
    object cgZeta: TCheckGroup
      Left = 8
      Height = 114
      Top = 8
      Width = 300
      AutoFill = True
      Caption = 'Damping ratio zeta'
      ClientHeight = 94
      ClientWidth = 296
      Columns = 4
      Items.Strings = (
        '0.05'
        '0.1'
        '0.2'
        '0.3'
        '0.5'
        '0.707'
        '1.0'
        '2.0'
      )
      TabOrder = 0
      OnItemClick = cgZetaItemClick
    end
    object lblFn: TLabel
      Left = 324
      Height = 15
      Top = 16
      Width = 130
      Caption = 'Natural frequency fn (Hz):'
    end
    object seFn: TFloatSpinEdit
      Left = 324
      Height = 23
      Top = 36
      Width = 100
      DecimalPlaces = 3
      Increment = 0.1
      MaxValue = 1000
      MinValue = 0.001
      TabOrder = 1
      Value = 1
      OnChange = seFnChange
    end
    object lblPeriods: TLabel
      Left = 324
      Height = 15
      Top = 68
      Width = 120
      Caption = 'Periods of fn to show:'
    end
    object sePeriods: TSpinEdit
      Left = 324
      Height = 23
      Top = 88
      Width = 100
      MaxValue = 200
      MinValue = 1
      TabOrder = 2
      Value = 10
      OnChange = sePeriodsChange
    end
    object memResults: TMemo
      Left = 480
      Height = 114
      Top = 8
      Width = 512
      Anchors = [akTop, akLeft, akRight]
      Font.Name = 'Consolas'
      ParentFont = False
      ReadOnly = True
      ScrollBars = ssAutoBoth
      TabOrder = 3
      WordWrap = False
    end
  end
  object pnlPlots: TPanel
    Left = 0
    Height = 670
    Top = 130
    Width = 1000
    Align = alClient
    BevelOuter = bvNone
    TabOrder = 1
    OnResize = pnlPlotsResize
  end
end
