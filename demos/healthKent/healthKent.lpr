program healthKent;

{*******************************************************************************

     Demo: Kent and Medway by LSOA - population density (ONS mid-2024
     estimates) and deprivation (English Indices of Deprivation 2025) on
     an OpenGL map, with towns over 50,000, motorways, trunk and A roads,
     railways and the population barycentre (computed with newVM), and a
     tab listing every information source. See uHealthMain.pas (the
     form), uKentMap.pas (the map) and uKentData.pas (the compiled-in
     data, generated by make_kent_data.py).

*******************************************************************************}

{$mode objfpc}{$H+}
{$I ../../newVMConfig.inc}

uses
  {$IF defined(UNIX) and not defined(DARWIN)}
  cthreads,
  {$ENDIF}
  Interfaces, // this includes the LCL widgetset
  Forms, cblas, uHealthMain;

begin
  {$IFDEF HAVE_BLAS}
  InitializeCBLAS;
  {$ENDIF}
  RequireDerivedFormResource := True;
  Application.Scaled := True;
  Application.Initialize;
  Application.CreateForm(TForm1, Form1);
  Application.Run;
end.
