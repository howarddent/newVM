program healthKent;

{*******************************************************************************

     Demo: Kent and Medway by LSOA - population density (ONS mid-2024
     estimates) and deprivation (English Indices of Deprivation 2025) on
     an OpenGL map, with towns over 50,000, motorways, trunk and A roads,
     railways and the population barycentre (computed with newVM), and a
     tab listing every information source. See uHealthMain.pas (the
     form), uKentMap.pas (the map) and uKentData.pas (the compiled-in
     data, generated by make_kent_data.py).

*******************************************************************************}

{$mode objfpc}{$H+}
{$I ../../newVMConfig.inc}

uses
  {$IF defined(UNIX) and not defined(DARWIN)}
  cthreads,
  {$ENDIF}
  Interfaces, // this includes the LCL widgetset
  SysUtils, Forms, cblas, uKentData, uHealthMain;

// --events=<file.csv>: each LSOA's expected admissions a year (heart attack
// and stroke, heart attack, STEMI), for make_drive_data.py
procedure WriteEvents(const FileName: string);
var
  f: TextFile;
  i: Integer;
begin
  AssignFile(f, FileName);
  Rewrite(f);
  WriteLn(f, 'i,code,events,mi,stemi');
  for i := 0 to LsoaCount - 1 do
    WriteLn(f, Format('%d,%s,%.6f,%.6f,%.6f', [i, LsoaCode[i], LsoaCvdEventsOf(i, 0),
      LsoaCvdEventsOf(i, 1), LsoaCvdEventsOf(i, 2)]));
  CloseFile(f);
end;

begin
  {$IFDEF HAVE_BLAS}
  InitializeCBLAS;
  {$ENDIF}
  RequireDerivedFormResource := True;
  Application.Scaled := True;
  Application.Initialize;
  if Application.HasOption('events') then begin
    WriteEvents(Application.GetOptionValue('events'));
    Exit;
  end;
  Application.CreateForm(TForm1, Form1);
  Application.Run;
end.
