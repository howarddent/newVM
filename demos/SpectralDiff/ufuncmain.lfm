object Form1: TForm1
  Left = 300
  Height = 820
  Top = 100
  Width = 1000
  Caption = 'newVM Spectral Differentiation Demo (DCT-I)'
  ClientHeight = 820
  ClientWidth = 1000
  OnCreate = FormCreate
  Position = poScreenCenter
  LCLVersion = '4.99.0.0'
  object Chart1: TChart
    Left = 0
    Height = 480
    Top = 0
    Width = 780
    AxisList = <
      item
        Grid.Color = clSilver
        Minors = <>
      end
      item
        Alignment = calBottom
        Grid.Color = clSilver
        Minors = <>
      end>
    Legend.Visible = True
    Title.Text.Strings = (
      'f(x) = exp(x)*sin(5x) on a Chebyshev grid'
    )
    Title.Visible = True
    Left = 0
    Top = 0
    object Chart1LineSeries1: TLineSeries
      Title = 'f(x)'
      LinePen.Color = clRed
      LinePen.Width = 2
    end
    object Chart1LineSeries2: TLineSeries
      Title = 'Chebyshev points'
      LineType = ltNone
      Pointer.Brush.Color = clPurple
      Pointer.Style = psDiamond
      Pointer.Visible = True
      ShowPoints = True
    end
    object Chart1LineSeries3: TLineSeries
      Title = 'Spectral derivative (DCT-I)'
      LinePen.Color = clBlue
      LinePen.Width = 2
    end
    object Chart1LineSeries4: TLineSeries
      Title = 'Exact derivative'
      LineType = ltNone
      Pointer.Visible = True
      ShowPoints = True
    end
  end
  object Chart2: TChart
    Left = 0
    Height = 260
    Top = 488
    Width = 780
    AxisList = <
      item
        Grid.Color = clSilver
        Minors = <>
      end
      item
        Alignment = calBottom
        Grid.Color = clSilver
        Minors = <>
      end>
    Title.Text.Strings = (
      'Error: exact - spectral derivative'
    )
    Title.Visible = True
    Left = 0
    Top = 488
    object Chart2LineSeries1: TLineSeries
      LinePen.Color = clGreen
    end
  end
  object Button1: TButton
    Left = 800
    Height = 25
    Top = 16
    Width = 180
    Caption = 'Execute'
    OnClick = Button1Click
    TabOrder = 0
  end
  object Memo1: TMemo
    Left = 800
    Height = 720
    Top = 56
    Width = 190
    ScrollBars = ssAutoVertical
    TabOrder = 1
  end
end
